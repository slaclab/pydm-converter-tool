<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <widget type="label" version="2.0.0">
    <name>Writer</name>
    <x>0</x>
    <y>0</y>
    <text>w</text>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
pvs[1].setValue(PVUtil.getDouble(pvs[0]) - 1)
]]></text>
        <pv_name>SR:MEM</pv_name>
        <pv_name>loc://MEM_USED</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Typed reader</name>
    <x>0</x>
    <y>30</y>
    <pv_name>loc://MEM_USED&lt;VDouble&gt;</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>No reader</name>
    <x>0</x>
    <y>60</y>
    <text>n</text>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
pvs[1].setValue(PVUtil.getDouble(pvs[0]))
]]></text>
        <pv_name>SR:FREE</pv_name>
        <pv_name>loc://orphan</pv_name>
      </script>
    </scripts>
  </widget>
</display>

{
  "schemaVersion": "1.0",
  "kind": "screen",
  "id": "rule_tokens",
  "metadata": {
    "title": "rule_tokens",
    "source": {
      "type": "bob-converter"
    },
    "size": {
      "width": 800,
      "height": 600
    }
  },
  "root": {
    "id": "w-001",
    "type": "absolute-canvas",
    "props": {
      "width": 800,
      "height": 600,
      "backgroundColor": "#ffffff"
    },
    "geometry": {
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 600
    },
    "children": [
      {
        "id": "w-002",
        "type": "pv-label",
        "props": {
          "pv": "SR:A",
          "foregroundColor": "#000000",
          "backgroundColor": "#f0f0f0"
        },
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 20
        },
        "rules": [
          {
            "id": "r-001",
            "name": "value",
            "targetProperty": "foregroundColor",
            "pvs": [
              {
                "name": "SR:A",
                "trigger": true
              },
              {
                "name": "SR:B",
                "trigger": true
              }
            ],
            "conditions": [
              {
                "expression": "{0} > 5",
                "value": "#ff0000"
              },
              {
                "expression": "floor({1}) == 2  or  {1} == \"3\"",
                "value": "#00ff00"
              }
            ],
            "default": "#000000"
          },
          {
            "id": "r-002",
            "name": "severity",
            "targetProperty": "backgroundColor",
            "pvs": [
              {
                "name": "SR:A",
                "trigger": true
              },
              {
                "name": "SR:A.SEVR",
                "trigger": true
              }
            ],
            "conditions": [
              {
                "expression": "{1} == 2",
                "value": "#ff0000"
              },
              {
                "expression": "(2 if {1}==1 else (1 if {1}==2 else (-1 if {1}>=3 else 0))) == 1",
                "value": "#00ff00"
              }
            ],
            "default": "#010203"
          }
        ],
        "warnings": [
          "Tokens: rule 'macro' condition not lowered: !(pv0 == ${COLOR_CODE})",
          "Tokens: rule 'badtoken' references pv3 but lists 1 PV(s)"
        ]
      }
    ]
  },
  "macros": []
}

<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <widget type="textupdate" version="2.0.0">
    <name>Real PV</name>
    <x>0</x>
    <y>0</y>
    <pv_name>SR:BEAM</pv_name>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from org.csstudio.display.builder.model.persist import WidgetColorService
sevr = PVUtil.getSeverity(pvs[0])
colorName = ("OK","MINOR","MAJOR","INVALID","DISCONNECTED")[sevr]
widget.setPropertyValue("foreground_color", WidgetColorService.getColor(colorName))
]]></text>
        <pv_name>SR:BEAM</pv_name>
      </script>
    </scripts>
  </widget>

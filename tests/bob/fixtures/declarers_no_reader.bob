<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <widget type="action_button" version="2.0.0">
    <name>Lonely</name>
    <x>0</x>
    <y>0</y>
    <pv_name>loc://flag&lt;VString&gt;(&quot;on&quot;)</pv_name>
    <actions>
      <action type="write_pv">
        <pv_name>$(pv_name)</pv_name>
        <value>2</value>
        <description>Set 2</description>
      </action>
    </actions>
  </widget>
</display>

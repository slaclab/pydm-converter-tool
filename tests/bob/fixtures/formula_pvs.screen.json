    },
    "size": {
      "width": 800,
      "height": 600
    }
  },
  "macros": [
    {
      "name": "P",
      "default": ""
    }
  ],
  "formulas": [
    {
      "name": "f-001",
      "kind": "scalar",
      "expression": "({0}*60)",
      "bindings": {
        "0": "SR:X"
      }
    },
    {
      "name": "f-002",
      "kind": "scalar",
      "expression": "abs({0}-{1}) <= 0.25",
      "bindings": {
        "0": "SR:A",
        "1": "SR:B"
      }
    },
    {
      "name": "f-003",
      "kind": "scalar",
      "expression": "{0} and {1}",
      "bindings": {
        "0": "${P}A",
        "1": "${P}B"
      }
    },
    {
      "name": "f-004",
      "kind": "scalar",
      "expression": "{0} + 1",
      "bindings": {
        "0": "SR:Q"
      }
    },
    {
      "name": "f-005",
      "kind": "scalar",
      "expression": "{0} > 2",
      "bindings": {
        "0": "SR:A"
      }
    },
    {
      "name": "f-006",
      "kind": "scalar",
      "expression": "{0} * 2",
      "bindings": {
        "0": "SR:WF"
      }
    }
  ],

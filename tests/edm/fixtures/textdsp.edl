4 0 0
beginScreenProperties
major 4
minor 0
release 0
x 0
y 0
w 400
h 300
font "helvetica-medium-r-12.0"
ctlFont "helvetica-medium-r-12.0"
btnFont "helvetica-medium-r-12.0"
endScreenProperties


# (Text Update, noedit, exponential format)
object activeXTextDspClass:noedit
beginObjectProperties
major 4
minor 6
release 0
x 10
y 10
w 120
h 18
controlPv "$(P):VAL"
format "exponential"
precision 3
showUnits
fgColor index 14
bgColor index 0
useDisplayBg
endObjectProperties

# (Text Update, noedit, decimal format)
object activeXTextDspClass:noedit
beginObjectProperties
major 4
minor 6
release 0
x 10
y 40
w 120
h 18
controlPv "$(P):RATE"
format "decimal"
endObjectProperties

# (Text Control, plain class with editable: stays a pv-text-input)
object activeXTextDspClass
beginObjectProperties
major 4
minor 6
release 0
x 10
y 70
w 120
h 18
controlPv "$(P):SETPOINT"
editable
endObjectProperties

# (Text Control, plain class without editable: read-only in EDM -> pv-label)
object activeXTextDspClass
beginObjectProperties
major 4
minor 7
release 0
x 10
y 100
w 120
h 18
controlPv "$(P):READBACK"
font "helvetica-bold-r-14.0"
fgColor rgb 0 0 65535
fgAlarm
bgColor rgb 65535 65535 65535
format "hex"
precision 2
fontAlign "right"
showUnits
endObjectProperties
